# Copy to .env and export values in your shell, or configure them in your host.
# Replace both secrets before any deployment beyond a local demo.
CHAINCERT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CHAINCERT_TOKEN_SECRET=replace-with-a-different-random-token-secret-at-least-32-characters
CHAINCERT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHAINCERT_DEMO_EMAIL=demo.admin@chaincert.local
CHAINCERT_DEMO_PASSWORD=ChainCertDemo!2026
